  m_Script: {fileID: 11500000, guid: c86192bb93b3b8a4ab40edb3e5b455f1, type: 3}
  m_Name: Note_Key8
  m_EditorClassIdentifier: 
  text: "\u041A\u043B\u044E\u0447 \u0443 \u043C\u0435\u043D\u044F\u2026 \u041A\u043E\u043C\u043D\u0430\u0442\u0430
    8 \u2014 \u043E\u043D\u0430 \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u0430\u044F,
    \u0441\u0442\u0435\u043D\u0430 \u0442\u0430\u043C \u0434\u044B\u0448\u0438\u0442.
    \u042F \u043D\u0430\u0448\u0451\u043B \u0449\u0435\u043B\u044C, \u043A\u0430\u043C\u0435\u043D\u044C
    \u043F\u043E\u0434\u0434\u0430\u043B\u0441\u044F \u2014 \u0437\u0430 \u043D\u0438\u043C
    \u043F\u0440\u043E\u0445\u043E\u0434, \u0432 \u0441\u0430\u043C\u043E\u0439 \u0441\u043A\u0430\u043B\u0435!
    \u0422\u0430\u043C \u0441\u0432\u0435\u0442, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439,
    \u043D\u0435 \u0431\u043E\u043B\u044C\u043D\u0438\u0447\u043D\u044B\u0439. \u042F
    \u0432\u044B\u0439\u0434\u0443. \u0421\u043A\u043E\u0440\u043E."
