  m_Name: Note_Key6
  m_EditorClassIdentifier: 
  text: "\u0412\u043E\u0442 \u043A\u043B\u044E\u0447 \u043E\u0442 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    8. \u0427\u0435\u0441\u0442\u043D\u043E, \u0431\u043E\u043B\u044C\u043D\u044B\u0435
    \u0442\u0430\u043C \u0443\u0436\u0435 \u0437\u0430\u0434\u043E\u043B\u0431\u0430\u043B\u0438
    \u043B\u0430\u0437\u0438\u0442\u044C \u2014 \u043F\u0443\u0441\u0442\u044C \u0445\u043E\u0442\u044C
    \u0442\u0435\u043F\u0435\u0440\u044C \u0431\u0443\u0434\u0435\u0442 \u043F\u043E\u0440\u044F\u0434\u043E\u043A.
    \u041D\u0435 \u0442\u0435\u0440\u044F\u0439 \u0438 \u043D\u0435 \u0434\u0430\u0432\u0430\u0439
    \u043D\u0438\u043A\u043E\u043C\u0443 \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A."
