  m_Name: Note_Key7
  m_EditorClassIdentifier: 
  text: "\u042F \u0432\u0437\u044F\u043B \u043A\u043B\u044E\u0447 \u043E\u0442 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    \u0441 \u043B\u0438\u0444\u0442\u043E\u043C. \u041E\u043D\u0438 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
    \u043D\u0435 \u0434\u0430\u0434\u0443\u0442 \u043C\u043D\u0435 \u0441\u0432\u043E\u0431\u043E\u0434\u0443,
    \u043D\u043E \u0441 \u044D\u0442\u0438\u043C \u043A\u043B\u044E\u0447\u043E\u043C
    \u044F \u043C\u043E\u0433\u0443 \u0445\u043E\u0442\u044C \u0447\u0443\u0442\u044C-\u0447\u0443\u0442\u044C
    \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C. \u041F\u0443\u0441\u0442\u044C
    \u0438\u0449\u0443\u0442 \u2014 \u044F \u0434\u0435\u0440\u0436\u0443 \u0435\u0433\u043E
    \u043F\u0440\u0438 \u0441\u0435\u0431\u0435."
