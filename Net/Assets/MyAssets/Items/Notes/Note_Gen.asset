  m_Name: Note_Gen
  m_EditorClassIdentifier: 
  text: "\u0415\u0441\u043B\u0438 \u043B\u0438\u0444\u0442 \u0432\u0434\u0440\u0443\u0433
    \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u2014 \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E, \u0441\u043D\u043E\u0432\u0430
    \u0437\u0430\u0433\u043B\u043E\u0445 \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u0432\u043D\u0438\u0437\u0443. \u042D\u0442\u043E\u0442 \u043A\u043B\u044E\u0447
    \u2014 \u043E\u0442 \u0435\u0433\u043E \u0437\u0430\u043C\u043A\u0430, \u0431\u0435\u0437
    \u043D\u0435\u0433\u043E \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440
    \u043D\u0435 \u0437\u0430\u0432\u0435\u0434\u0451\u0448\u044C. \u0414\u0435\u0440\u0436\u0438
    \u043F\u0440\u0438 \u0441\u0435\u0431\u0435 \u0438\u043B\u0438 \u043A\u043B\u0430\u0434\u0438
    \u043D\u0430 \u043C\u0435\u0441\u0442\u043E, \u0430 \u0442\u043E \u043E\u043F\u044F\u0442\u044C
    \u0431\u0443\u0434\u0435\u043C \u0438\u0441\u043A\u0430\u0442\u044C \u043F\u043E
    \u0432\u0441\u0435\u043C\u0443 \u044D\u0442\u0430\u0436\u0443."
